{
  "name": "canvcode",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @canvcode/web",
    "build": "npm run typecheck && npm run build -w @canvcode/web",
    "start": "node apps/server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint",
    "snapshot": "node apps/server/src/snapshot.ts",
    "import": "node apps/server/src/import-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
